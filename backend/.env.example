# WeatherGPT Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0

# Ollama LLM Config
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cache Config (seconds)
CACHE_TTL=300

# Database Config (PostgreSQL - Phase 3)
DATABASE_URL=postgresql://user:password@localhost:5432/weathergpt

# Security & Auth Config (Phase 12)
JWT_SECRET=super-secret-key-change-in-production

# SMS Provider Config (Phase 11 - Not configured by default)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
